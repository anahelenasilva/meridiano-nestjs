{
  "name": "meridiano-nestjs",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22 <23",
    "pnpm": "10"
  },
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "briefing": "ts-node -r tsconfig-paths/register src/scripts/runBriefing.ts",
    "briefing:tech": "ts-node -r tsconfig-paths/register src/scripts/runBriefing.ts --feed technology",
    "briefing:brasil": "ts-node -r tsconfig-paths/register src/scripts/runBriefing.ts --feed brasil",
    "briefing:teclas": "ts-node -r tsconfig-paths/register src/scripts/runBriefing.ts --feed teclas",
    "briefing:scrape": "ts-node -r tsconfig-paths/register src/scripts/runBriefing.ts --scrape",
    "briefing:process": "ts-node -r tsconfig-paths/register src/scripts/runBriefing.ts --process",
    "briefing:rate": "ts-node -r tsconfig-paths/register src/scripts/runBriefing.ts --rate",
    "briefing:generate": "ts-node -r tsconfig-paths/register src/scripts/runBriefing.ts --generate",
    "generate:openapi": "ts-node -r tsconfig-paths/register src/scripts/generateOpenApi.ts",
    "yt-transcript": "ts-node -r tsconfig-paths/register src/scripts/runYoutubeTranscripts.ts",
    "process-transcriptions": "ts-node -r tsconfig-paths/register src/scripts/runProcessTranscriptions.ts",
    "list-transcriptions": "ts-node -r tsconfig-paths/register src/scripts/runListTranscriptions.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d libs/database/typeorm.config.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:run": "ts-node scripts/run-migrations.ts",
    "migration:run:direct": "typeorm-ts-node-commonjs migration:run -d libs/database/typeorm.config.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d libs/database/typeorm.config.ts",
    "docker:up": "docker-compose --profile local up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f postgres",
    "sandcastle:run": "npx tsx .sandcastle/main.mts",
    "sandcastle:build": "docker build -t sandcastle:meridiano-nestjs --build-arg HOST_UID=\"$(id -u)\" --build-arg HOST_GID=\"$(id -g)\" .sandcastle/"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.985.0",
    "@aws-sdk/s3-presigned-post": "^3.971.0",
    "@aws-sdk/s3-request-presigner": "^3.985.0",
    "@mozilla/readability": "0.5.0",
    "@nestjs/common": "11.0.1",
    "@nestjs/core": "11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "11.0.1",
    "@nestjs/typeorm": "11.0.0",
    "axios": "1.15.2",
    "bcrypt": "^6.0.0",
    "bullmq": "5.66.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "commander": "12.1.0",
    "dotenv": "17.2.3",
    "form-data": "4.0.5",
    "groq-sdk": "^0.37.0",
    "ioredis": "5.8.2",
    "jsdom": "23.0.0",
    "mailgun.js": "11.1.0",
    "marked": "17.0.1",
    "ml-kmeans": "6.0.0",
    "moment": "2.30.1",
    "openai": "4.67.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "8.11.3",
    "reflect-metadata": "0.2.2",
    "rss-parser": "3.13.0",
    "rxjs": "7.8.1",
    "typeorm": "^0.3.28",
    "youtube-transcript-plus": "^1.0.0",
    "youtubei.js": "16.0.1"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.5.10",
    "@eslint/eslintrc": "3.2.0",
    "@eslint/js": "9.18.0",
    "@nestjs/cli": "11.0.0",
    "@nestjs/schematics": "11.0.0",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/testing": "11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/ioredis": "5.0.0",
    "@types/jest": "30.0.0",
    "@types/jsdom": "21.1.0",
    "@types/marked": "6.0.0",
    "@types/node": "22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "8.10.9",
    "@types/supertest": "6.0.2",
    "eslint": "9.18.0",
    "eslint-config-prettier": "10.0.1",
    "eslint-plugin-prettier": "5.2.2",
    "eslint-plugin-project-structure": "^3.14.2",
    "globals": "16.0.0",
    "jest": "30.0.0",
    "jest-mock-extended": "4.0.0",
    "prettier": "3.4.2",
    "source-map-support": "0.5.21",
    "supertest": "7.0.0",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "mjs",
      "json",
      "ts"
    ],
    "roots": [
      "<rootDir>/src",
      "<rootDir>/libs"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "useESM": false,
          "tsconfig": {
            "esModuleInterop": true,
            "allowSyntheticDefaultImports": true
          }
        }
      ],
      "^.+\\.mjs$": [
        "ts-jest",
        {
          "useESM": false
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(\\.pnpm/(youtubei.js|marked)@[^/]+/node_modules/)?(youtubei.js|marked)/)"
    ],
    "moduleNameMapper": {
      "^youtubei.js$": "<rootDir>/src/__mocks__/youtubei.js.ts",
      "^youtubei.js/web$": "<rootDir>/src/__mocks__/youtubei.js.ts",
      "^youtube-transcript-plus$": "<rootDir>/src/__mocks__/youtube-transcript-plus.ts",
      "^marked$": "<rootDir>/node_modules/marked/lib/marked.umd.js",
      "^@libs/(.*)$": "<rootDir>/libs/$1"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s",
      "libs/**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node"
  }
}
