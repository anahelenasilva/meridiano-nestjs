NODE_ENV=development # or production

# AI Keys
DEEPSEEK_API_KEY=
EMBEDDING_API_KEY=

# Ports (for nginx)
HTTP_PORT=80
HTTPS_PORT=443

# Redis Configuration for BullMQ
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Database Configuration
DATABASE_TYPE=postgres
DATABASE_HOST=yourhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=PWD
DATABASE_NAME=meridian

# CORS Origins
CORS_ORIGINS=https://your-ip,https://www.your-ip

# Email provider
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# JWT Authentication
JWT_SECRET=your-secret-key-change-in-production
