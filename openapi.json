{
  "components": {
    "schemas": {
      "AddBookmarkResponseDto": {
        "properties": {
          "already_bookmarked": {
            "type": "boolean"
          },
          "article_id": {
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        },
        "required": [
          "already_bookmarked",
          "id",
          "article_id",
          "created_at"
        ],
        "type": "object"
      },
      "CreateArticleDto": {
        "properties": {
          "customPrompt": {
            "maxLength": 500,
            "type": "string"
          },
          "feedProfile": {
            "enum": [
              "default",
              "technology",
              "politics",
              "business",
              "health",
              "science",
              "brasil",
              "teclas"
            ],
            "type": "string"
          },
          "generateAudio": {
            "type": "boolean"
          },
          "url": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "url",
          "feedProfile"
        ],
        "type": "object"
      },
      "CreateBookmarkDto": {
        "properties": {
          "article_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "article_id"
        ],
        "type": "object"
      },
      "CreateUserDto": {
        "properties": {
          "email": {
            "format": "email",
            "type": "string"
          },
          "password": {
            "minLength": 8,
            "pattern": "^(?=.*[a-zA-Z])(?=.*[A-Z])(?=.*\\d).+$",
            "type": "string"
          },
          "username": {
            "maxLength": 30,
            "minLength": 3,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "type": "string"
          }
        },
        "required": [
          "email",
          "username",
          "password"
        ],
        "type": "object"
      },
      "CreateYoutubeChannelDto": {
        "properties": {
          "channelId": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "maxVideos": {
            "minimum": 1,
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "channelId",
          "name",
          "url",
          "description",
          "enabled"
        ],
        "type": "object"
      },
      "CreateYoutubeTranscriptionDto": {
        "properties": {
          "channelId": {
            "type": "string"
          },
          "customPrompt": {
            "maxLength": 500,
            "type": "string"
          },
          "generateAudio": {
            "type": "boolean"
          },
          "url": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "url",
          "channelId"
        ],
        "type": "object"
      },
      "CustomPromptsDto": {
        "properties": {
          "briefSynthesis": {
            "type": "string"
          },
          "clusterAnalysis": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "ExternalCreateArticleDto": {
        "properties": {
          "customPrompt": {
            "maxLength": 500,
            "type": "string"
          },
          "feedProfile": {
            "enum": [
              "default",
              "technology",
              "politics",
              "business",
              "health",
              "science",
              "brasil",
              "teclas"
            ],
            "type": "string"
          },
          "generateAudio": {
            "type": "boolean"
          },
          "metadata": {
            "$ref": "#/components/schemas/ExternalSubmissionMetadataDto"
          },
          "source": {
            "type": "string"
          },
          "url": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "url",
          "feedProfile"
        ],
        "type": "object"
      },
      "ExternalSubmissionMetadataDto": {
        "properties": {
          "chatId": {
            "type": "string"
          },
          "messageId": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "GenerateBriefInputDto": {
        "properties": {
          "customPrompts": {
            "$ref": "#/components/schemas/CustomPromptsDto"
          },
          "feedProfile": {
            "enum": [
              "default",
              "technology",
              "politics",
              "business",
              "health",
              "science",
              "brasil",
              "teclas"
            ],
            "type": "string"
          }
        },
        "required": [
          "feedProfile"
        ],
        "type": "object"
      },
      "GenerateUploadUrlDto": {
        "properties": {
          "articleFileName": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "fileSize": {
            "type": "number"
          },
          "s3Bucket": {
            "type": "string"
          }
        },
        "required": [
          "articleFileName"
        ],
        "type": "object"
      },
      "LoginDto": {
        "properties": {
          "email": {
            "format": "email",
            "type": "string"
          },
          "password": {
            "minLength": 8,
            "pattern": "^(?=.*[a-zA-Z])(?=.*\\d).+$",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "LoginResponseDto": {
        "properties": {
          "access_token": {
            "type": "string"
          },
          "user": {
            "properties": {
              "email": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "username": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "email",
              "username"
            ],
            "type": "object"
          }
        },
        "required": [
          "access_token",
          "user"
        ],
        "type": "object"
      },
      "NoteResponseDto": {
        "properties": {
          "content": {
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "content",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "ProcessMarkdownArticleDto": {
        "properties": {
          "customPrompt": {
            "maxLength": 500,
            "type": "string"
          },
          "feedProfile": {
            "enum": [
              "default",
              "technology",
              "politics",
              "business",
              "health",
              "science",
              "brasil",
              "teclas"
            ],
            "type": "string"
          },
          "generateAudio": {
            "type": "boolean"
          },
          "s3Bucket": {
            "type": "string"
          },
          "s3Key": {
            "type": "string"
          }
        },
        "required": [
          "s3Key",
          "feedProfile"
        ],
        "type": "object"
      },
      "SaveNoteDto": {
        "properties": {
          "content": {
            "maxLength": 5000,
            "type": "string"
          },
          "source_id": {
            "format": "uuid",
            "type": "string"
          },
          "source_type": {
            "enum": [
              "article",
              "transcription"
            ],
            "type": "string"
          }
        },
        "required": [
          "source_type",
          "source_id",
          "content"
        ],
        "type": "object"
      },
      "SaveNoteResponseDto": {
        "properties": {
          "note": {
            "allOf": [
              {
                "$ref": "#/components/schemas/NoteResponseDto"
              }
            ],
            "nullable": true,
            "type": "object"
          }
        },
        "required": [
          "note"
        ],
        "type": "object"
      },
      "UnauthorizedResponseDto": {
        "properties": {
          "message": {
            "example": "Unauthorized",
            "type": "string"
          },
          "statusCode": {
            "example": 401,
            "type": "number"
          }
        },
        "required": [
          "statusCode",
          "message"
        ],
        "type": "object"
      },
      "UpdateChannelEnabledDto": {
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "enabled"
        ],
        "type": "object"
      },
      "UserResponseDto": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "username",
          "created_at"
        ],
        "type": "object"
      },
      "ValidationErrorResponseDto": {
        "properties": {
          "error": {
            "example": "Bad Request",
            "type": "string"
          },
          "message": {
            "example": [
              "source_id must be a valid UUID"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "statusCode": {
            "example": 400,
            "type": "number"
          }
        },
        "required": [
          "statusCode",
          "message",
          "error"
        ],
        "type": "object"
      },
      "YoutubeChannelResponseDto": {
        "properties": {
          "channelId": {
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "maxVideos": {
            "nullable": true,
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "channelId",
          "name",
          "url",
          "description",
          "enabled",
          "maxVideos",
          "createdAt",
          "updatedAt"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "",
    "title": "Meridiano API",
    "version": "1.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/articles": {
      "get": {
        "operationId": "ArticlesController_listArticles",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Paginated list of articles"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedResponseDto"
                }
              }
            },
            "description": "Missing or invalid bearer token"
          }
        },
        "summary": "List the authenticated user's articles",
        "tags": [
          "Articles"
        ]
      },
      "post": {
        "operationId": "ArticlesController_create",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateArticleDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Article scraped and queued for processing"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponseDto"
                }
              }
            },
            "description": "Request failed class-validator validation"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedResponseDto"
                }
              }
            },
            "description": "Missing or invalid bearer token"
          }
        },
        "summary": "Scrape a URL and queue the resulting article for processing",
        "tags": [
          "Articles"
        ]
      }
    },
    "/api/articles/external": {
      "post": {
        "operationId": "ExternalArticlesController_createExternal",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExternalCreateArticleDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Article submitted successfully and queued for processing"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponseDto"
                }
              }
            },
            "description": "Request failed class-validator validation"
          },
          "401": {
            "description": "Missing or invalid X-External-Token header"
          },
          "409": {
            "description": "Article already exists"
          },
          "429": {
            "description": "Rate limit exceeded"
          },
          "503": {
            "description": "External article submission is currently disabled"
          }
        },
        "summary": "Submit an external article URL for scraping and processing",
        "tags": [
          "ExternalArticles"
        ]
      }
    },
    "/api/articles/jobs/{jobId}": {
      "get": {
        "operationId": "ArticlesController_getJobStatus",
        "parameters": [
          {
            "in": "path",
            "name": "jobId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Job status retrieved"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedResponseDto"
                }
              }
            },
            "description": "Missing or invalid bearer token"
          },
          "404": {
            "description": "Job not found"
          }
        },
        "summary": "Get the status of an article processing job",
        "tags": [
          "Articles"
        ]
      }
    },
    "/api/articles/markdown": {
      "post": {
        "operationId": "ArticlesController_processMarkdownArticle",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProcessMarkdownArticleDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Markdown article queued for processing"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponseDto"
                }
              }
            },
            "description": "Request failed class-validator validation"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedResponseDto"
                }
              }
            },
            "description": "Missing or invalid bearer token"
          }
        },
        "summary": "Queue a markdown article stored in S3 for processing",
        "tags": [
          "Articles"
        ]
      }
    },
    "/api/articles/upload-url": {
      "post": {
        "operationId": "ArticlesController_generateUploadUrl",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateUploadUrlDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Presigned upload URL generated"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponseDto"
                }
              }
            },
            "description": "Request failed class-validator validation"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedResponseDto"
                }
              }
            },
            "description": "Missing or invalid bearer token"
          }
        },
        "summary": "Generate a presigned S3 upload URL for an article file",
        "tags": [
          "Articles"
        ]
      }
    },
    "/api/articles/{id}": {
      "delete": {
        "operationId": "ArticlesController_deleteArticle",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Article deleted"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedResponseDto"
                }
              }
            },
            "description": "Missing or invalid bearer token"
          }
        },
        "summary": "Delete an article by id",
        "tags": [
          "Articles"
        ]
      },
      "get": {
        "operationId": "ArticlesController_getArticle",
