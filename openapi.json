{
  "components": {
    "schemas": {
      "NoteResponseDto": {
        "properties": {
          "content": {
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "content",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "SaveNoteDto": {
        "properties": {
          "content": {
            "maxLength": 5000,
            "type": "string"
          },
          "source_id": {
            "format": "uuid",
            "type": "string"
          },
          "source_type": {
            "enum": [
              "article",
              "transcription"
            ],
            "type": "string"
          }
        },
        "required": [
          "source_type",
          "source_id",
          "content"
        ],
        "type": "object"
      },
      "SaveNoteResponseDto": {
        "properties": {
          "note": {
            "allOf": [
              {
                "$ref": "#/components/schemas/NoteResponseDto"
              }
            ],
            "nullable": true,
            "type": "object"
          }
        },
        "required": [
          "note"
        ],
        "type": "object"
      },
      "UnauthorizedResponseDto": {
        "properties": {
          "message": {
            "example": "Unauthorized",
            "type": "string"
          },
          "statusCode": {
            "example": 401,
            "type": "number"
          }
        },
        "required": [
          "statusCode",
          "message"
        ],
        "type": "object"
      },
      "ValidationErrorResponseDto": {
        "properties": {
          "error": {
            "example": "Bad Request",
            "type": "string"
          },
          "message": {
            "example": [
              "source_id must be a valid UUID"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "statusCode": {
            "example": 400,
            "type": "number"
          }
        },
        "required": [
          "statusCode",
          "message",
          "error"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "",
    "title": "Meridiano API",
    "version": "1.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/notes": {
      "post": {
        "operationId": "NotesController_saveNote",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveNoteDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SaveNoteResponseDto"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponseDto"
                }
              }
            },
            "description": "Request failed class-validator validation"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedResponseDto"
                }
              }
            },
            "description": "Missing or invalid bearer token"
          }
        },
        "summary": "Save an authenticated user note",
        "tags": [
          "Notes"
        ]
      }
    }
  },
  "servers": [],
  "tags": []
}
