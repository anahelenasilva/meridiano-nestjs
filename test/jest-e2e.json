{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", {
      "tsconfig": {
        "paths": {
          "@libs/*": ["libs/*"]
        }
      }
    }]
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(youtubei.js)/)"
  ],
  "moduleNameMapper": {
    "^youtubei.js$": "<rootDir>/../src/__mocks__/youtubei.js.ts",
    "^@libs/(.*)$": "<rootDir>/../libs/$1"
  }
}
