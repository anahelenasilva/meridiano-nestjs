# Setup sequence (one-time):
#   1. pnpm add -D @ai-hero/sandcastle
#   2. cp .sandcastle/.env.example .sandcastle/.env   # then fill in values below
#   3. npx sandcastle docker build-image              # ~2-3 min, produces sandcastle:meridiano-nestjs; rebuild after Claude Code CLI updates
#   4. pnpm run sandbox:implement                     # now works

# Anthropic API key
# If you want to use your Claude subscription instead of an API key, see https://github.com/mattpocock/sandcastle/issues/191
ANTHROPIC_API_KEY=
# GitHub personal access token
GH_TOKEN=
